<div class="big_text">
<<nobr>>


    

    <<if $mc.stats.mana gte 30  >>

    <div class="scene-container">

        <div class="story-box">
        <div class="bar-wrapper">
        <div class="bar">
            <div class="segment">10</div>
            <div class="segment" id="seg1">0</div>
            <div class="segment" id="seg2">2</div>
            <div class="segment" id="seg3">5</div>
            <div class="segment" id="seg4">0</div>
            <div class="cursor"></div>
        </div>
    

        <p id="result"></p>

        <div  id="stop-button" onclick="statsChange(-10, 'Mana')" >
            <p>STOP </p>
        </div>
        </div>
    
                <video id="sceneVideo" class="scene-image"  muted autoplay loop="loop" type='video/mp4; codecs="avc1.42E01E, mp4a.40.2"' controls>
                </video>

            <p class="notation_text"><<print $fuckScene[$sceneCode][$sceneType].scene_dialogue[$sceneNumber]>></p>

   
        </div>
        

        <<set _random_value = random(1, 5)>>

        <div id="random-button" onclick="statsChange(-10, 'Mana'); charStatsChangeRandom(); forwardTime(1);" data-passage="$loc" class="enter-button" >
            <p >Random Point</p>
        </div>
        
  

         <div id="leave-button" onclick="forwardTime(1);" data-passage="$loc" class="enter-button">
            <p >Leave</p>
        </div>

        </div>
    
    <<else>>
        <img class="scene-image" @src="setup.ImagePath+'scenes/misc/low.jpg'">

        <p class="notation_text">You do not have enough Mana!</p>


        <div class="enter-button" onclick="forwardTime(1);" data-passage="$loc">
                    <p >Leave</p>
                </div>
    <</if>>
 
       
   

<</nobr>>
</div>

<<script>>
  /* pure JavaScript code */

$(document).ready(function() {

    sceneLoad(variables().sceneCode,variables().sceneNumber,variables().sceneType);

$("#stop-button").on("click", function() {
    stopGame(variables().activityType,'Char',variables().char);
    
});

    

  });
<</script>>

 